{
  "uid": "flow-overview",
  "title": "Traffic Flow — Content & Users",
  "tags": ["flow"],
  "timezone": "Asia/Jakarta",
  "schemaVersion": 39,
  "version": 2,
  "editable": true,
  "time": { "from": "now-30d", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "customer_id",
        "label": "Customer",
        "type": "query",
        "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse_flow" },
        "query": "SELECT toString(customer_id) AS __value, customer_name AS __text FROM flow.exporter_map ORDER BY customer_name",
        "refresh": 1,
        "includeAll": false,
        "multi": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Top Content Providers (by network)",
      "type": "table",
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse_flow" },
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          { "matcher": { "id": "byName", "options": "Bytes" }, "properties": [ { "id": "unit", "value": "bytes" }, { "id": "custom.cellOptions", "value": { "type": "gauge", "mode": "gradient" } } ] }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse_flow" },
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT provider AS Provider, sum(bytes) AS Bytes FROM flow.provider_hourly WHERE exporter_ip IN (SELECT exporter_ip FROM flow.exporter_map WHERE customer_id = $customer_id) AND $__timeFilter(hour) GROUP BY Provider ORDER BY Bytes DESC LIMIT 15"
        }
      ]
    },
    {
      "id": 2,
      "title": "Top Internal Users",
      "type": "table",
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse_flow" },
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          { "matcher": { "id": "byName", "options": "Bytes" }, "properties": [ { "id": "unit", "value": "bytes" }, { "id": "custom.cellOptions", "value": { "type": "gauge", "mode": "gradient" } } ] }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse_flow" },
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT internal_ip AS `Internal IP`, sum(bytes) AS Bytes FROM flow.user_hourly WHERE exporter_ip IN (SELECT exporter_ip FROM flow.exporter_map WHERE customer_id = $customer_id) AND $__timeFilter(hour) GROUP BY `Internal IP` ORDER BY Bytes DESC LIMIT 15"
        }
      ]
    },
    {
      "id": 3,
      "title": "Traffic over time (bytes per hour — Download / Upload)",
      "type": "timeseries",
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse_flow" },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 10 },
      "fieldConfig": {
        "defaults": { "unit": "bytes", "custom": { "drawStyle": "line", "fillOpacity": 20, "lineWidth": 1 } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse_flow" },
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT $__timeInterval(hour) AS time, sum(download) AS \"Download\", sum(upload) AS \"Upload\" FROM flow.traffic_hourly WHERE exporter_ip IN (SELECT exporter_ip FROM flow.exporter_map WHERE customer_id = $customer_id) AND $__timeFilter(hour) GROUP BY time ORDER BY time"
        }
      ]
    }
  ]
}
