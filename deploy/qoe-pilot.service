# systemd unit to bring the stack up automatically after a VM reboot.
#
# Install:
#   sudo cp deploy/qoe-pilot.service /etc/systemd/system/qoe-pilot.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now qoe-pilot.service
#
# Adjust WorkingDirectory to wherever you actually deployed the project
# (this assumes it lives at /opt/qoe-pilot).

[Unit]
Description=QoE Pilot Docker Compose Stack
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/qxm
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
