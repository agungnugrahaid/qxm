# Reverse proxy + automatic TLS (Let's Encrypt) for the whole stack.
#
# Fill in real domains/subdomains before deploying — these are placeholders.
# All four need DNS A/AAAA records pointing at this VM's public IP.
#
# ingestion is the only one that MUST be public (250 CPE routers push to
# it). Grafana/Adminer/admin-ui are internal tools — gated with basic auth
# below as a baseline; if you have a fixed admin/office IP range or a VPN,
# swap the basicauth block for an IP allowlist instead (stronger, and
# means credentials leaking isn't enough to get in).

{
	email agungnugraha.id@gmail.com
}

qxm.gmedia.net.id {
	reverse_proxy ingestion-api:8000
}

qxm-admin.gmedia.net.id {
	basicauth {
		# Generate with: docker compose run --rm caddy caddy hash-password
		admin $2a$14$.vBtj0nhwUYokq2aERhVeuvKPZ9x9/rMVmFeWE/uskUoFSDkMApY6
	}
	reverse_proxy admin-ui:8082
}

qxm-grafana.gmedia.net.id {
	# No Caddy basic-auth here -- Grafana's own login is the gate.
	# (Removed the double-login: it caused password mix-ups between the two.)
	reverse_proxy grafana:3000
}

qxm-adminer.gmedia.net.id {
	basicauth {
		admin $2a$14$.vBtj0nhwUYokq2aERhVeuvKPZ9x9/rMVmFeWE/uskUoFSDkMApY6
	}
	reverse_proxy adminer:8080
}
