# Copy to .env and fill in real values. .env itself is gitignored -- never
# commit real secrets.

# TimescaleDB / Postgres
DB_PASSWORD=changeme

# Grafana admin account
GRAFANA_PASSWORD=changeme

# Public URL for Grafana itself -- used to build the public-dashboard links
# generated by admin-ui's "Share Dashboard" button (see dashboard_share.py).
GRAFANA_PUBLIC_URL=https://grafana.yourisp.com

# Public URL routers push metrics/firmware to (Caddy-fronted ingestion-api)
INGEST_BASE_URL=https://monitor.yourisp.com

# Optional: Slack/Discord-compatible incoming webhook for watchdog alerts.
# Leave blank to just log locally.
WEBHOOK_URL=

# Shared SFTP account routers use to push daily config snapshots (see
# routeros/README.md's "Daily config snapshot" section, and
# config-snapshot-watcher/). SFTP_HOST is this server's public hostname --
# same one routers already reach for INGEST_BASE_URL.
SFTP_PASSWORD=changeme
SFTP_HOST=monitor.yourisp.com
SFTP_PORT=2222

# Comma-separated CIDR allowlist for the SFTP port -- restricts it at the
# host firewall level (see deploy/setup-sftp-firewall.sh) so it isn't open
# to the whole internet. Should cover your own network's public IP ranges
# plus any CPE routers' egress ranges. Also reused as the router-side
# "gmedia-all-ip" management-access allowlist by
# routeros/qoe-baseline-hardening-v7/v6.rsc -- one CIDR list, not two.
SFTP_ALLOWED_CIDRS=

# The two fixed, fleet-wide RADIUS servers wired up by
# routeros/qoe-baseline-hardening-v7/v6.rsc. If a secret contains a
# literal `$`, escape it as `$$` -- Compose's .env parsing interpolates
# unescaped `$word` as a variable reference and silently truncates it
# otherwise (confirmed the hard way: `...Xcs$w` got parsed as `...Xcs`
# plus a nonexistent `$w` variable defaulting to blank).
RADIUS_SERVER_1_SECRET=changeme
RADIUS_SERVER_2_SECRET=changeme

# Shared auth token between Grafana and the image renderer (Grafana
# refuses its default value in production mode). Any random string.
RENDERER_TOKEN=changeme

# SMTP relay for the monthly customer PDF reports (see reporting/).
# The on-demand download button in admin-ui works without these; only
# the automated email path needs them.
SMTP_HOST=changeme
SMTP_PORT=587
SMTP_USER=changeme
SMTP_PASSWORD=changeme
REPORT_FROM_ADDRESS=reports@yourisp.com

# Where routers send remote syslog (see syslog-forwarder/) -- same host as
# SFTP_HOST/INGEST_BASE_URL, different port. Injected into every router's
# /system logging config automatically on deploy (deploy_lib.py).
SYSLOG_HOST=monitor.yourisp.com
SYSLOG_PORT=1514
